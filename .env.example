APP_NAME=Borna Process Control API
APP_VERSION=0.1.0
API_PREFIX=/api/v1
ENVIRONMENT=dev
DEBUG=true
DOCS_ENABLED=true
AUTH_TOKEN_TTL_HOURS=12
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
SECURITY_RECENT_EVENT_LIMIT=20
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE_SECONDS=31536000
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
# Production target: set DEBUG=false, DOCS_ENABLED=false, SECURITY_HSTS_ENABLED=true
# Production target: postgresql+psycopg://postgres:postgres@db:5432/borna_chart
DATABASE_URL=sqlite:///./borna_chart.db
